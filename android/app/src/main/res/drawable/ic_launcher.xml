<?xml version="1.0" encoding="utf-8"?>
<!-- App-Symbol: schwarzes abgerundetes Quadrat mit orangem Uhren-Ring -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
            <corners android:radius="22dp" />
            <size android:width="96dp" android:height="96dp" />
        </shape>
    </item>
    <item android:bottom="22dp" android:left="22dp" android:right="22dp" android:top="22dp">
        <shape android:shape="oval">
            <stroke android:width="8dp" android:color="#FF9F0A" />
        </shape>
    </item>
</layer-list>
